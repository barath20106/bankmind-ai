# ==========================================
# BankMind AI - Environment Configuration
# ==========================================

# Application Settings
APP_NAME=BankMind AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# SQLite Database
DATABASE_URL=sqlite:///./bankmind.db

# Google Gemini API Configuration
# Optional: If not provided, BankMind AI runs in Deterministic Demo Mode
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
