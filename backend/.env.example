# BankMind AI - Backend Environment Configuration
APP_NAME="BankMind AI"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

DATABASE_URL=sqlite:///./bankmind.db

# Google Gemini API Configuration
# If left empty, BankMind AI will automatically run in Deterministic Demo Mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
